# ==============================================================
# KernelSU Action - OPPO A93s 5G / MT6833 / Linux 4.14
# ==============================================================
CONFIG_ENV=config.env

# ========================================================== Kernel source ==

KERNEL_SOURCE=https://github.com/LF-Repo/kernel_oppo_mt6833
KERNEL_SOURCE_BRANCH=dev

KERNEL_CONFIG=PFGM00_defconfig
KERNEL_IMAGE_NAME=Image.gz-dtb

ARCH=arm64

KERNEL_NAME=OPPO-A93s-MT6833-KernelSU
ADD_LOCALVERSION_TO_FILENAME=false

# =========================================================== Toolchain ====

# dev-main 已验证使用 clang 10.0 + GCC 4.9
# 因此这里不使用 Action 默认的 r450784e，
# 而是尽可能复现 dev-main 原来的编译环境。

USE_CUSTOM_CLANG=true
CUSTOM_CLANG_SOURCE=https://github.com/crdroidandroid/android_prebuilts_clang_host_linux-x86_clang-6443078
CUSTOM_CLANG_BRANCH=10.0

CUSTOM_CMDS:CLANG_TRIPLE=aarch64-linux-gnu-

# 不使用 LLVM=1 / LLVM_IAS=1
# 4.14 原内核自己的 build.config 使用 clang + external assembler。
USE_LLVM=false

# GCC 4.9
ENABLE_GCC_ARM64=true
ENABLE_GCC_ARM32=true

USE_CUSTOM_GCC_64=false
CUSTOM_GCC_64_SOURCE=
CUSTOM_GCC_64_BRANCH=
CUSTOM_GCC_64_BIN=aarch64-linux-android-

USE_CUSTOM_GCC_32=false
CUSTOM_GCC_32_SOURCE=
CUSTOM_GCC_32_BRANCH=
CUSTOM_GCC_32_BIN=arm-linux-androideabi-

# ============================================================= KernelSU ===

# rsuntk/KernelSU = RKSU
KSU_VARIANT=rsuntk
KSU_REF=

# 4.14 使用 manual hook
KSU_HOOK_MODE=manual

# 使用官方/默认 Manager
KSU_EXPECTED_SIZE=
KSU_EXPECTED_HASH=

# ================================================================ SUSFS ===

# 第一轮不要加入 SUSFS。
# 先确认单独 KernelSU 可以正常启动并取得 root。
ENABLE_SUSFS=false

SUSFS_REPO=https://gitlab.com/simonpunk/susfs4ksu.git
SUSFS_BRANCH=auto

# ========================================================== Extra patches ===

# 4.14 < 5.9，需要 path_umount backport。
ENABLE_PATH_UMOUNT=true

# 第一轮不隐藏 KernelSU 痕迹
ENABLE_HIDE_STUFF=false

# 第一轮不使用 KPM
ENABLE_KPM=false

# ================================================================ Kconfig ===

ADD_KPROBES_CONFIG=false
ADD_OVERLAYFS_CONFIG=true

DISABLE_LTO=false
DISABLE_CC_WERROR=false

EXTRA_DEFCONFIG=

# =========================================================== AnyKernel3 ===

USE_CUSTOM_ANYKERNEL3=true

CUSTOM_ANYKERNEL3_SOURCE=https://github.com/LF-Repo/AnyKernel3
CUSTOM_ANYKERNEL3_BRANCH=master

# ================================================================ Packaging ===

NEED_DTBO=false

# 第一轮不让 Action 自动重打 boot.img
# 你已经有自己把 Image.gz-dtb 塞进 boot.img 的流程。
BUILD_BOOT_IMG=false
SOURCE_BOOT_IMAGE=https://raw.githubusercontent.com/Zhengyscla/KernelSU_Action-fork/refs/heads/main/boot/boot.img

# ================================================================ Runner ===

ENABLE_CCACHE=true
REMOVE_UNUSED_PACKAGES=true
